<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-payment-cards-table" author="gava751">
        <createTable tableName="payment_cards">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="number" type="varchar(19)">
                <constraints nullable="false"/>
            </column>
            <column name="holder" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="expiration_date" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="payment_cards"
                baseColumnNames="user_id"
                constraintName="fk_payment_cards_user"
                referencedTableName="users"
                referencedColumnNames="id"/>

        <rollback>
            <dropTable tableName="payment_cards"/>
        </rollback>
    </changeSet>

    <changeSet id="002-create-payment-cards-indexes" author="gava751">
        <createIndex indexName="idx_payment_cards_number" tableName="payment_cards" unique="true">
            <column name="number"/>
        </createIndex>

        <createIndex indexName="idx_payment_cards_user_id" tableName="payment_cards">
            <column name="user_id"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_payment_cards_user_id" tableName="payment_cards"/>
            <dropIndex indexName="idx_payment_cards_number" tableName="payment_cards"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
